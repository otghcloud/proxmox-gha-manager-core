{
    "name": "otghcloud/gha-plugin-prebuilt",
    "version": "0.1.0",
    "description": "Prebuilt artifact importer plugin for Proxmox GHA Manager",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.17"
    },
    "autoload": {
        "psr-4": {
            "OTGH\\ProxmoxGHA\\Prebuilt\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OTGH\\ProxmoxGHA\\Prebuilt\\PrebuiltServiceProvider"
            ]
        }
    }
}